# Copy to .env and fill in. Every value here overrides config.json.
# A real environment variable always wins over the same name in this file.

# Local API keys clients present to the gateway (required).
OPENCODE2API_SERVER_KEYS=sk-local-change-me

# Upstream key pools. Leave empty to use the anonymous free lane only.
OPENCODE2API_ZEN_KEYS=
OPENCODE2API_GO_KEYS=
OPENCODE2API_ANONYMOUS=true

# Listeners. PORT is honored by PaaS platforms and maps to 0.0.0.0:<PORT>.
OPENCODE2API_LISTEN=127.0.0.1:8080
OPENCODE2API_WEBUI_LISTEN=0.0.0.0:8081

# Management console.
OPENCODE2API_WEBUI_ENABLED=true
OPENCODE2API_WEBUI_USERNAME=admin
OPENCODE2API_WEBUI_PASSWORD=change-this-admin-password

# Routing and logging.
OPENCODE2API_PREFER=go
OPENCODE2API_LOG_LEVEL=info
OPENCODE2API_PROXIES=direct

# Optional Cloudflare WARP egress for free-model traffic.
OPENCODE2API_WARP_ENABLED=false
